    "reason_aac_not_verifiable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AAC-Codierung weist keine feste Grenzfrequenzsignatur auf – die Erkennung ist nur bei niedrigen Bitraten zuverlässig und kann um eine Stufe danebenliegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AAC encoding has no fixed cutoff signature — detection is only reliable at low bitrates and can misjudge by one step."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'encodage AAC n'a pas de signature de coupure fixe — la détection n'est fiable qu'à de faibles débits et peut se tromper d'un cran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La codifica AAC non ha una frequenza di taglio fissa: il rilevamento è affidabile solo a bitrate bassi e può sbagliare di un livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AAC エンコードには固定のカットオフ特性がありません。検出は低ビットレートでのみ信頼性があり、1 段階誤認する可能性があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодирование AAC не имеет фиксированного среза частот — определение надёжно только на низких битрейтах и может ошибаться на одну ступень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AAC 编码没有固定的截止特征——检测仅在低比特率下可靠，并且可能会出现一级偏差。"
          }
        }
      }
    },
    "reason_opus_not_verifiable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus hat keine bitrateabhängige Grenzfrequenz – eine Spektralanalyse ist nicht anwendbar, verwenden Sie stattdessen die Header-Bitrate."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus has no bitrate-dependent cutoff — spectral detection is not applicable, use the header bitrate instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus n'a pas de coupure dépendante du débit — l'analyse spectrale n'est pas applicable, utilisez plutôt le débit d'en-tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus non ha un taglio dipendente dal bitrate: l'analisi spettrale non è applicabile, utilizzare il bitrate dell'intestazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus にはビットレート依存のカットオフがありません。スペクトル検出は適用できないため、ヘッダーのビットレートを参照してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus не имеет зависящего от битрейта среза частот — спектральный анализ неприменим, ориентируйтесь на битрейт в заголовке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opus 没有依赖比特率的截止频率——频谱检测不适用，请改用标头比特率。"
          }
        }
      }
    },
    "reason_suspected_double_encode" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "320 kbps deklariert, aber das Audio wurde deutlich niedriger gemessen – Datei wurde möglicherweise mit niedrigerer Bitrate neu codiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declared 320 kbps but the audio was measured much lower — file may be re-encoded from a lower bitrate"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "320 kbps déclarés mais l'audio mesuré est bien inférieur — le fichier a peut-être été réencodé à partir d'un débit inférieur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichiarati 320 kbps ma l'audio misurato è molto inferiore: il file potrebbe essere stato ricodificato da un bitrate inferiore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "320 kbps と記載されていますが、音声の測定値は大幅に低くなっています。低ビットレートから再エンコードされた可能性があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявлен битрейт 320 кбит/с, но реальные параметры звука значительно ниже — возможно, файл был перекодирован из более низкого качества"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声明为 320 kbps，但音频测量值要低得多——文件可能是从较低比特率重新编码的"
          }
        }
      }
    },
    "reason_vorbis_approximate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbis-Qualitätsstufen lassen sich nicht durch Cutoff trennen – nur die grobe Unterscheidung zwischen niedriger und hoher Qualität ist messbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbis quality levels are not separable by cutoff — only the broad distinction between low and high quality is measurable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les niveaux de qualité Vorbis ne sont pas séparables par coupure — seule la distinction globale entre basse et haute qualité est mesurable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli di qualità Vorbis non sono separabili mediante taglio: è misurabile solo la distinzione approssimativa tra bassa e alta qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbis の品質レベルはカットオフでは分離できません。低品質と高品質の大まかな区別のみが測定可能です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уровни качества Vorbis не разделяются по частотному срезу — надёжно определяется только общая граница между низким и высоким качеством."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbis 质量级别无法通过截止频率区分——只能测量低质量和高质量之间的大致区别。"
          }
        }
      }
    },
