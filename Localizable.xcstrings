    "auto_volume_leveling_disclaimer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lautheitsberechnung erfolgt nach dem EBU R128-Standard mit hoher Präzision. Bei seltener extremer Dynamik sind minimale Abweichungen möglich. Dedizierte Tools wie rsgain werden für eingebettete Tags weiterhin voll unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated using the EBU R128 standard with high loudness precision. In rare cases with extreme dynamics, slight deviations may occur. Dedicated tools like rsgain remain fully supported for embedded tags."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calcul du volume suit la norme EBU R128 avec une grande précision. Dans de rares cas de dynamique extrême, de légères variations peuvent survenir. Des outils dédiés comme rsgain restent pleinement pris en charge pour les tags intégrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il calcolo del volume segue lo standard EBU R128 con elevata precisione. In rari casi di dinamica estrema potrebbero verificarsi lievi scostamenti. Strumenti dedicati come rsgain restano pienamente supportati per i tag incorporati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EBU R128規格に準拠し高精度に音量を算出します。極端なダイナミクスを持つ楽曲では僅かな誤差が生じる場合があります。恒久的なタグ付けにはrsgainなどの専用ツールも引き続き利用可能です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расчёт громкости выполняется по стандарту EBU R128 с высокой точностью. В редких треках с нестандартной динамикой возможны небольшие отклонения. Для точных тегов вы по-прежнему можете использовать утилиты вроде rsgain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 EBU R128 标准进行高精度响度计算。在极少数动态范围极端的音轨中可能会有轻微偏差。若需写入永久标签，仍可搭配 rsgain 等专业工具使用。"
          }
        }
      }
    },
    "Automated audio engine validation, metadata readers, parser benchmarks & storage checks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Validierung der Audio-Engine, Metadaten-Leser, Parser-Benchmarks und Speicherprüfungen"
          }
        },
        "en" : {
