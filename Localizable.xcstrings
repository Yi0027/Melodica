    "id3_version_tooltip" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3: Weitgehend kompatibel mit allen Playern und Geräten, verwendet UTF-16 und TYER für das Jahr.\nID3v2.4: Moderner Standard, verwendet UTF-8 und TDRC für das Jahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3: Most widely compatible across players and devices, uses UTF-16 and TYER for year.\nID3v2.4: Modern standard, uses UTF-8 and TDRC for year."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3 : le plus largement compatible avec les lecteurs et appareils, utilise UTF-16 et TYER pour l'année.\nID3v2.4 : norme moderne, utilise UTF-8 et TDRC pour l'année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3: ampiamente compatibile tra lettori e dispositivi, utilizza UTF-16 e TYER per anno.\nID3v2.4: standard moderno, utilizza UTF-8 e TDRC per l'anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3: プレーヤーとデバイス間で最も広く互換性があり、UTF-16 と TYER を使用します。\nID3v2.4: 最新の標準。年には UTF-8 と TDRC を使用します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3: Максимальная совместимость с устройствами (UTF-16, TYER).\nID3v2.4: Современный стандарт (UTF-8, TDRC)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID3v2.3：跨播放器和设备兼容性最好，使用 UTF-16 和 TYER 表示年份。\nID3v2.4：现代标准，使用 UTF-8 和 TDRC 表示年份。"
          }
        }
      }
    },
