    "reset_app_section_description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Melodica auf die Werkseinstellungen zurück. Alle importierten Musiktitel, Playlists, Wiedergabezustände und Einstellungen werden dauerhaft gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset Melodica to factory defaults. All imported tracks, playlists, playback state, and settings will be permanently erased."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialise Melodica aux paramètres d'usine. Tous les morceaux importés, playlists, états de lecture et réglages seront définitivement effacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina Melodica alle impostazioni di fabbrica. Tutti i brani importati, le playlist, lo stato di riproduzione e le impostazioni verranno eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melodica を初期設定にリセットします。インポートされた音楽、プレイリスト、再生状態、設定がすべて完全に消去されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить Melodica до начального состояния. Все импортированные треки, плейлисты, история воспроизведения и настройки будут безвозвратно удалены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Melodica 重置为出厂默认设置。所有导入的音乐、播放列表、播放状态和设置都将被永久删除。"
          }
        }
      }
    },
